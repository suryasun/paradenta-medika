// Parakita - Phase 1 (Foundation/MVP) database schema
// Source: docs/06-tasks/task-003.md, docs/03-sad/06-database-design.md,
//         docs/03-sad/07-data-dictionary.md, docs/03-sad/08-erd.md
// Table plurality and users/role shape resolved via document priority
// (task-003.md over SAD) -- see Epic J implementation report for detail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & Authorization (docs/03-sad/06-database-design.md Section 19-20)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                   String     @id @default(uuid()) @db.Char(36)
  username             String     @unique @db.VarChar(50)
  email                String     @unique @db.VarChar(100)
  passwordHash         String     @map("password_hash") @db.VarChar(255)
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?  @map("last_login_at")
  failedLoginCount     Int        @default(0) @map("failed_login_count")
  lockedUntil          DateTime?  @map("locked_until")
  requirePasswordReset Boolean    @default(false) @map("require_password_reset")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  userRoles           UserRole[]
  userSessions        UserSession[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  doctor              Doctor?

  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Char(36)
  roleCode    String  @unique @map("role_code") @db.VarChar(30)
  roleName    String  @map("role_name") @db.VarChar(100)
  description String? @db.Text
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id             String  @id @default(uuid()) @db.Char(36)
  module         String  @db.VarChar(50)
  permissionKey  String  @unique @map("permission_key") @db.VarChar(100)
  permissionName String  @map("permission_name") @db.VarChar(150)
  description    String? @db.Text

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Char(36)
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id                       String    @id @default(uuid()) @db.Char(36)
  userId                   String    @map("user_id") @db.Char(36)
  deviceId                 String?   @map("device_id") @db.VarChar(100)
  deviceName               String?   @map("device_name") @db.VarChar(100)
  deviceType               String?   @map("device_type") @db.VarChar(30)
  browser                  String?   @db.VarChar(50)
  ipAddress                String?   @map("ip_address") @db.VarChar(45)
  refreshTokenHash         String?   @map("refresh_token") @db.VarChar(64)
  /// Previous rotated-out hash, retained only to detect refresh-token reuse
  /// per docs/04-ai-contract/05-auth-contract.md AUTH-034..AUTH-037. Exact
  /// reuse-detection storage mechanism is NOT DEFINED IN SAD beyond the
  /// requirement itself; this is the minimal structure that satisfies it.
  previousRefreshTokenHash String?   @map("previous_refresh_token") @db.VarChar(64)
  expiredAt                DateTime  @map("expired_at")
  lastUsedAt               DateTime? @map("last_used_at")
  revokedAt                DateTime? @map("revoked_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  token     String    @db.Text
  expiredAt DateTime  @map("expired_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// docs/06-tasks/task-011.md Database Impact: "New password_reset_tokens
/// table ... storing token hash, expiry, used flag."
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiredAt DateTime  @map("expired_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Master Data (docs/03-sad/06-database-design.md Section 23-28)
// ---------------------------------------------------------------------------

/// docs/03-sad/11-module-master-data.md Section 11.1 Main Attributes: Code,
/// Name, Legal Name, Tax Number, Email, Phone, Address are required; Logo is
/// optional and not implemented in Phase 1 (no attachment/storage
/// integration exists yet -- deferred until a task actually needs it).
model Clinic {
  id         String  @id @default(uuid()) @db.Char(36)
  clinicCode String  @unique @map("clinic_code") @db.VarChar(20)
  clinicName String  @map("clinic_name") @db.VarChar(150)
  legalName  String  @map("legal_name") @db.VarChar(200)
  taxNumber  String  @map("tax_number") @db.VarChar(50)
  ownerName  String? @map("owner_name") @db.VarChar(150)
  phone      String  @db.VarChar(30)
  email      String  @db.VarChar(100)
  address    String  @db.Text
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  branches Branch[]

  @@map("clinics")
}

model Branch {
  id         String  @id @default(uuid()) @db.Char(36)
  clinicId   String  @map("clinic_id") @db.Char(36)
  branchCode String  @unique @map("branch_code") @db.VarChar(20)
  branchName String  @map("branch_name") @db.VarChar(150)
  phone      String  @db.VarChar(30)
  email      String  @db.VarChar(100)
  address    String  @db.Text
  timezone   String  @default("Asia/Jakarta") @db.VarChar(50)
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  clinic               Clinic                @relation(fields: [clinicId], references: [id])
  doctors              Doctor[]
  reservations         Reservation[]
  invoices             Invoice[]
  queues               Queue[]
  visits               Visit[]
  warehouseLocations   WarehouseLocation[]
  purchaseOrders       PurchaseOrder[]
  financeAccounts      Account[]
  journals             Journal[]
  financialPeriods     FinancialPeriod[]
  cashAccounts         CashAccount[]
  expenses             Expense[]
  dailyClosings        DailyClosing[]
  doctorFeeSettlements DoctorFeeSettlement[]

  @@map("branches")
}

model TreatmentCategory {
  id           String  @id @default(uuid()) @db.Char(36)
  categoryCode String  @unique @map("category_code") @db.VarChar(30)
  categoryName String  @map("category_name") @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  treatments Treatment[]

  @@map("treatment_categories")
}

model Treatment {
  id                  String   @id @default(uuid()) @db.Char(36)
  treatmentCode       String   @unique @map("treatment_code") @db.VarChar(30)
  treatmentName       String   @map("treatment_name") @db.VarChar(200)
  treatmentCategoryId String   @map("treatment_category_id") @db.Char(36)
  durationMinute      Int?     @map("duration_minute")
  defaultPrice        Decimal  @map("default_price") @db.Decimal(18, 2)
  doctorFee           Decimal? @map("doctor_fee") @db.Decimal(18, 2)
  isActive            Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  treatmentCategory  TreatmentCategory   @relation(fields: [treatmentCategoryId], references: [id])
  visitTreatments    VisitTreatment[]
  treatmentPlanItems TreatmentPlanItem[]

  @@index([treatmentCategoryId])
  @@map("treatments")
}

// docs/03-sad/11-module-master-data.md Section 8.1 ("Tooth Condition |
// Referensi Kondisi Gigi") + docs/03-sad/15-module-emr.md Part 3.1C Section
// 21.2 "Condition Category" -- literal list.
enum ToothConditionCategory {
  HEALTHY
  DISEASE
  RESTORATION
  PROSTHODONTIC
  ENDODONTIC
  SURGICAL
  ORTHODONTIC
  IMPLANTOLOGY
}

model ToothCondition {
  id            String                 @id @default(uuid()) @db.Char(36)
  conditionCode String                 @unique @map("condition_code") @db.VarChar(30)
  conditionName String                 @map("condition_name") @db.VarChar(100)
  category      ToothConditionCategory
  colorCode     String?                @map("color_code") @db.VarChar(20)
  isActive      Boolean                @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  odontogramEntries OdontogramEntry[]

  @@map("tooth_conditions")
}

model PaymentMethod {
  id         String  @id @default(uuid()) @db.Char(36)
  methodCode String  @unique @map("method_code") @db.VarChar(30)
  methodName String  @map("method_name") @db.VarChar(100)
  isCash     Boolean @default(false) @map("is_cash")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  payments Payment[]

  @@map("payment_methods")
}

/// docs/06-tasks/task-023.md Required Existing Code: "a Doctor is also
/// typically a User -- this task should link to an existing user_id rather
/// than duplicating identity" -- resolved via document priority over
/// docs/03-sad/11-module-master-data.md Section 11.6, which links Doctor to
/// Employee (no `employees` table exists in the Phase 1 schema, task-003).
/// `specialization` stays a plain string: no Specialty master table
/// (SAD Section 11.8) is in the Phase 1 table list either.
model Doctor {
  id              String    @id @default(uuid()) @db.Char(36)
  doctorCode      String    @unique @map("doctor_code") @db.VarChar(30)
  userId          String    @unique @map("user_id") @db.Char(36)
  branchId        String    @map("branch_id") @db.Char(36)
  fullName        String    @map("full_name") @db.VarChar(150)
  sipNumber       String?   @map("sip_number") @db.VarChar(50)
  strNumber       String?   @map("str_number") @db.VarChar(50)
  specialization  String?   @db.VarChar(100)
  consultationFee Decimal?  @map("consultation_fee") @db.Decimal(18, 2)
  joinDate        DateTime? @map("join_date") @db.Date
  phone           String?   @db.VarChar(30)
  email           String?   @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  user                   User                    @relation(fields: [userId], references: [id])
  branch                 Branch                  @relation(fields: [branchId], references: [id])
  reservations           Reservation[]
  queues                 Queue[]
  visits                 Visit[]
  schedules              DoctorSchedule[]
  periodontalAssessments PeriodontalAssessment[]
  prescriptions          Prescription[]
  consents               Consent[]
  medicalCertificates    MedicalCertificate[]
  feeSettlements         DoctorFeeSettlement[]

  @@index([branchId])
  @@map("doctors")
}

// ---------------------------------------------------------------------------
// Patient (docs/03-sad/06-database-design.md Section 30)
// ---------------------------------------------------------------------------

enum PatientIdentityType {
  KTP
  PASSPORT
  SIM
}

enum PatientGender {
  MALE
  FEMALE
}

/// docs/03-sad/12-module-patient.md Section 16.1 Required Fields: Full
/// Name/Gender/Date of Birth/Phone Number/Address are required; Identity
/// Type/Number are optional (conflicts with the earlier Epic J schema,
/// which had made identity required and phone/address absent -- corrected
/// here per this module's own required-fields table, which outranks the
/// generic 06-database-design.md table it was first drafted from).
/// `address` is a flat field rather than a separate patient_addresses table:
/// task-003's Backend Scope only authorizes a single `patients` table for
/// Phase 1, and the documented address shape (province/city/district/village
/// ids) requires a Geographic master hierarchy that doesn't exist in Phase 1.
model Patient {
  id               String               @id @default(uuid()) @db.Char(36)
  medicalRecordNo  String               @unique @map("medical_record_no") @db.VarChar(30)
  patientName      String               @map("patient_name") @db.VarChar(150)
  identityType     PatientIdentityType? @map("identity_type")
  identityNumber   String?              @map("identity_number") @db.VarChar(50)
  birthPlace       String?              @map("birth_place") @db.VarChar(100)
  birthDate        DateTime             @map("birth_date") @db.Date
  gender           PatientGender
  phone            String               @db.VarChar(30)
  email            String?              @db.VarChar(100)
  address          String               @db.Text
  registrationDate DateTime             @default(now()) @map("registration_date")
  active           Boolean              @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  reservations           Reservation[]
  visits                 Visit[]
  invoices               Invoice[]
  queues                 Queue[]
  medicalHistories       MedicalHistory[]
  allergies              Allergy[]
  odontogramEntries      OdontogramEntry[]
  treatmentPlanItems     TreatmentPlanItem[]
  periodontalAssessments PeriodontalAssessment[]
  referrals              Referral[]
  followUps              FollowUp[]
  attachments            Attachment[]
  prescriptions          Prescription[]
  consents               Consent[]
  medicalCertificates    MedicalCertificate[]

  @@unique([identityType, identityNumber])
  @@index([patientName])
  @@index([phone])
  @@index([active])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Reservation (docs/03-sad/06-database-design.md Section 32)
// ---------------------------------------------------------------------------

/// Status values per docs/03-sad/01-system-overview.md Section 21.2, cited
/// literally by task-002.md's Acceptance Criteria (initial status BOOKED)
/// and task-032.md (rejects updates in IN_SERVICE); this list conflicts
/// with two other SAD sources (06-database-design.md's original
/// CONFIRMED/SERVING naming and 13-module-reservation.md's Draft/Confirmed/
/// InTreatment state machine) -- resolved via document priority (Task
/// Specification over SAD) in favor of the terms the tasks actually cite.
enum ReservationStatus {
  BOOKED
  CONFIRMED
  CHECK_IN
  IN_QUEUE
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  WALK_IN
  PHONE
  WHATSAPP
  WEBSITE
  MOBILE_APP
}

/// docs/03-sad/13-module-reservation.md Section 19.3 Reservation Entity,
/// reconciled with the Phase 1 table set already established: scheduleId
/// is nullable because Walk-in reservations (Section 17) have no schedule
/// slot to reference.
model Reservation {
  id              String            @id @default(uuid()) @db.Char(36)
  reservationNo   String            @unique @map("reservation_no") @db.VarChar(30)
  patientId       String            @map("patient_id") @db.Char(36)
  doctorId        String            @map("doctor_id") @db.Char(36)
  branchId        String            @map("branch_id") @db.Char(36)
  scheduleId      String?           @map("schedule_id") @db.Char(36)
  reservationDate DateTime          @map("reservation_date") @db.Date
  reservationTime DateTime          @map("reservation_time") @db.Time()
  reservationType String            @map("reservation_type") @db.VarChar(30)
  complaint       String?           @db.Text
  notes           String?           @db.Text
  status          ReservationStatus @default(BOOKED)
  source          ReservationSource
  checkedInAt     DateTime?         @map("checked_in_at")
  cancelledReason String?           @map("cancelled_reason") @db.Text
  cancelledAt     DateTime?         @map("cancelled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  // docs/06-tasks/task-064.md: "may link back to treatment_plan_items via a
  // new FK column" -- nullable since most Reservations don't originate from
  // a Treatment Plan.
  treatmentPlanItemId String? @map("treatment_plan_item_id") @db.Char(36)

  patient           Patient               @relation(fields: [patientId], references: [id])
  doctor            Doctor                @relation(fields: [doctorId], references: [id])
  branch            Branch                @relation(fields: [branchId], references: [id])
  schedule          DoctorSchedule?       @relation(fields: [scheduleId], references: [id])
  treatmentPlanItem TreatmentPlanItem?    @relation(fields: [treatmentPlanItemId], references: [id])
  queue             Queue?
  visits            Visit[]
  timelines         ReservationTimeline[]
  followUps         FollowUp[]

  @@index([patientId])
  @@index([doctorId])
  @@index([reservationDate])
  @@index([status])
  @@map("reservations")
}

/// docs/06-tasks/task-036.md explicitly authorizes introducing this table
/// if Doctor Schedule Validation (Section 15) / Time Slot Management
/// (Section 16) require a distinct schedule entity; fields match the
/// `doctor_schedules` table already documented in
/// docs/03-sad/06-database-design.md Section 25.
model DoctorSchedule {
  id           String   @id @default(uuid()) @db.Char(36)
  doctorId     String   @map("doctor_id") @db.Char(36)
  dayOfWeek    Int      @map("day_of_week")
  startTime    DateTime @map("start_time") @db.Time()
  endTime      DateTime @map("end_time") @db.Time()
  slotDuration Int      @map("slot_duration")
  maxPatient   Int      @map("max_patient")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  reservations Reservation[]

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_schedules")
}

/// docs/06-tasks/task-033.md/task-034.md require appending a "Reservation
/// Timeline" entry on reschedule/cancel. Fields per the only concrete
/// definition given anywhere in the SAD, docs/03-sad/01-system-overview.md
/// Section 21.3: Tanggal & Waktu, User, Status Lama, Status Baru, Catatan.
model ReservationTimeline {
  id             String   @id @default(uuid()) @db.Char(36)
  reservationId  String   @map("reservation_id") @db.Char(36)
  previousStatus String?  @map("previous_status") @db.VarChar(30)
  newStatus      String   @map("new_status") @db.VarChar(30)
  note           String?  @db.Text
  occurredAt     DateTime @default(now()) @map("occurred_at")
  userId         String?  @map("user_id") @db.Char(36)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@map("reservation_timelines")
}

// ---------------------------------------------------------------------------
// Queue (docs/03-sad/06-database-design.md Section 34)
// ---------------------------------------------------------------------------

/// docs/03-sad/14-module-queue.md Section 19 Available Status / Section 23
/// Queue State Transition (the authoritative transition table; any
/// transition not shown there is invalid). Renamed SERVING -> IN_SERVICE
/// and added NO_SHOW to match this module-specific doc over the earlier,
/// less detailed docs/03-sad/06-database-design.md Section 34 enum used
/// when this table was first drafted in Epic J.
enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  SKIPPED
}

enum QueuePriority {
  NORMAL
  ELDERLY
  PREGNANT
  EMERGENCY
  VIP
}

/// docs/03-sad/14-module-queue.md Section 9/10 Queue Types.
enum QueueType {
  WALK_IN
  RESERVATION
  EMERGENCY
}

/// Fields per docs/03-sad/14-module-queue.md Section 52 Queue Entity
/// (`queue_tickets`). `clinicId` (Poli/department) and `chairId` (Dental
/// Chair) are omitted: no Poli/Department or Dental Chair master table
/// exists in the Phase 1 schema (Epic C did not build one) -- `room`
/// (already present from Epic J) stands in as the lightweight equivalent.
/// `reservationId` is nullable: task-037 explicitly supports walk-in queue
/// creation with no prior reservation.
model Queue {
  id                String        @id @default(uuid()) @db.Char(36)
  reservationId     String?       @unique @map("reservation_id") @db.Char(36)
  branchId          String        @map("branch_id") @db.Char(36)
  patientId         String        @map("patient_id") @db.Char(36)
  queueNumber       String        @map("queue_number") @db.VarChar(20)
  queuePrefix       String        @map("queue_prefix") @db.VarChar(10)
  queueDate         DateTime      @map("queue_date") @db.Date
  queueType         QueueType     @map("queue_type")
  doctorId          String        @map("doctor_id") @db.Char(36)
  room              String?       @db.VarChar(50)
  priority          QueuePriority @default(NORMAL)
  status            QueueStatus   @default(WAITING)
  currentPosition   Int?          @map("current_position")
  estimatedCallTime DateTime?     @map("estimated_call_time")
  checkedInAt       DateTime      @default(now()) @map("checked_in_at")
  calledAt          DateTime?     @map("called_at")
  startedAt         DateTime?     @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  notes             String?       @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  reservation Reservation?   @relation(fields: [reservationId], references: [id])
  patient     Patient        @relation(fields: [patientId], references: [id])
  branch      Branch         @relation(fields: [branchId], references: [id])
  doctor      Doctor         @relation(fields: [doctorId], references: [id])
  visit       Visit?
  histories   QueueHistory[]
  calls       QueueCall[]

  @@unique([queueNumber, queueDate, branchId])
  @@index([queueDate])
  @@index([status])
  @@index([doctorId])
  @@index([patientId])
  @@map("queues")
}

/// docs/03-sad/14-module-queue.md Section 53 Queue History Entity
/// (`queue_histories`): records every status transition.
model QueueHistory {
  id             String   @id @default(uuid()) @db.Char(36)
  queueId        String   @map("queue_id") @db.Char(36)
  previousStatus String?  @map("previous_status") @db.VarChar(30)
  currentStatus  String   @map("current_status") @db.VarChar(30)
  reason         String?  @db.VarChar(255)
  changedBy      String?  @map("changed_by") @db.Char(36)
  changedAt      DateTime @default(now()) @map("changed_at")

  queue Queue @relation(fields: [queueId], references: [id])

  @@index([queueId])
  @@map("queue_histories")
}

/// docs/03-sad/14-module-queue.md Section 54 Queue Call Entity
/// (`queue_calls`): records every call/recall.
model QueueCall {
  id           String   @id @default(uuid()) @db.Char(36)
  queueId      String   @map("queue_id") @db.Char(36)
  recallNumber Int      @map("recall_number")
  calledBy     String?  @map("called_by") @db.Char(36)
  calledAt     DateTime @default(now()) @map("called_at")

  queue Queue @relation(fields: [queueId], references: [id])

  @@index([queueId])
  @@map("queue_calls")
}

// ---------------------------------------------------------------------------
// EMR Basic - Visit (docs/03-sad/06-database-design.md Section 39)
// ---------------------------------------------------------------------------

/// docs/03-sad/15-module-emr.md Section 15 Visit Status (this module-specific
/// doc's own status list, replacing the earlier WAITING/IN_PROGRESS/ON_HOLD/
/// COMPLETED/CANCELLED enum drafted in Epic J from the generic
/// 06-database-design.md before this module's own doc had been read).
enum VisitStatus {
  DRAFT
  WAITING_EXAMINATION
  IN_PROGRESS
  COMPLETED
  LOCKED
  ARCHIVED
}

/// docs/03-sad/15-module-emr.md Section 15 Business Rules: Visit only from
/// a Called Queue, one Queue = one Visit, must have Doctor+Patient+Branch.
/// `reservationId` is nullable (a walk-in Queue, per Epic F, may have none);
/// `branchId` added (was missing) and derived from the doctor at open time.
model Visit {
  id             String      @id @default(uuid()) @db.Char(36)
  visitNo        String      @unique @map("visit_no") @db.VarChar(30)
  reservationId  String?     @map("reservation_id") @db.Char(36)
  patientId      String      @map("patient_id") @db.Char(36)
  doctorId       String      @map("doctor_id") @db.Char(36)
  branchId       String      @map("branch_id") @db.Char(36)
  queueId        String      @unique @map("queue_id") @db.Char(36)
  visitDate      DateTime    @map("visit_date")
  chiefComplaint String?     @map("chief_complaint") @db.Text
  status         VisitStatus @default(DRAFT)
  startedAt      DateTime?   @map("started_at")
  finishedAt     DateTime?   @map("finished_at")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  reservation            Reservation?            @relation(fields: [reservationId], references: [id])
  patient                Patient                 @relation(fields: [patientId], references: [id])
  doctor                 Doctor                  @relation(fields: [doctorId], references: [id])
  branch                 Branch                  @relation(fields: [branchId], references: [id])
  queue                  Queue                   @relation(fields: [queueId], references: [id])
  invoice                Invoice?
  vitalSigns             VitalSign[]
  soapNote               SoapNote?
  diagnoses              VisitDiagnosis[]
  treatmentEntries       VisitTreatment[]
  medicalHistories       MedicalHistory[]
  allergies              Allergy[]
  odontogramEntries      OdontogramEntry[]
  treatmentPlanItems     TreatmentPlanItem[]
  periodontalAssessments PeriodontalAssessment[]
  referrals              Referral[]
  followUps              FollowUp[]
  attachments            Attachment[]
  prescriptions          Prescription[]
  consents               Consent[]
  medicalCertificates    MedicalCertificate[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
  @@index([status])
  @@map("visits")
}

/// docs/03-sad/15-module-emr.md Section 17 Vital Sign Data.
model VitalSign {
  id               String   @id @default(uuid()) @db.Char(36)
  visitId          String   @map("visit_id") @db.Char(36)
  bloodPressure    String?  @map("blood_pressure") @db.VarChar(20)
  heartRate        Int?     @map("heart_rate")
  respiratoryRate  Int?     @map("respiratory_rate")
  temperature      Decimal? @db.Decimal(4, 1)
  weight           Decimal? @db.Decimal(5, 2)
  height           Decimal? @db.Decimal(5, 2)
  oxygenSaturation Int?     @map("oxygen_saturation")
  recordedAt       DateTime @default(now()) @map("recorded_at")
  recordedBy       String?  @map("recorded_by") @db.Char(36)

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("vital_signs")
}

/// docs/03-sad/15-module-emr.md Section 16 SOAP Note. One SOAP Note per
/// Visit (docs/03-sad/06-database-design.md Section 40: "Satu Visit
/// memiliki satu SOAP Note").
model SoapNote {
  id         String   @id @default(uuid()) @db.Char(36)
  visitId    String   @unique @map("visit_id") @db.Char(36)
  subjective String?  @db.Text
  objective  String?  @db.Text
  assessment String?  @db.Text
  plan       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Char(36)

  visit Visit @relation(fields: [visitId], references: [id])

  @@map("soap_notes")
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

/// docs/03-sad/15-module-emr.md Section 21: diagnoses normally reference a
/// Master Diagnosis catalog, but no Diagnosis Reference master data task
/// exists in Phase 1 (flagged as a scope gap by task-051.md itself). Uses
/// the free-text `diagnosisName` shape from docs/03-sad/06-database-design.md
/// Section 43's `diagnoses` table instead of Section 43.2's
/// `visit_diagnoses.diagnosis_code_id` FK, since that FK's target table
/// does not exist -- this sidesteps inventing an undocumented master table.
model VisitDiagnosis {
  id            String        @id @default(uuid()) @db.Char(36)
  visitId       String        @map("visit_id") @db.Char(36)
  diagnosisType DiagnosisType @map("diagnosis_type")
  diagnosisName String        @map("diagnosis_name") @db.VarChar(255)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  createdBy     String?       @map("created_by") @db.Char(36)

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("visit_diagnoses")
}

/// docs/06-tasks/task-053.md: EMR-008/009 combined into one basic entry;
/// `unitPrice`/`subtotal` are a price snapshot taken from Treatment at
/// entry time so later catalog price changes don't retroactively alter
/// historical visits.
model VisitTreatment {
  id             String   @id @default(uuid()) @db.Char(36)
  visitId        String   @map("visit_id") @db.Char(36)
  treatmentId    String   @map("treatment_id") @db.Char(36)
  toothReference String?  @map("tooth_reference") @db.VarChar(50)
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  subtotal       Decimal  @db.Decimal(18, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by") @db.Char(36)

  visit     Visit     @relation(fields: [visitId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@index([visitId])
  @@map("visit_treatments")
}

// ---------------------------------------------------------------------------
// Medical History & Allergy (docs/06-tasks/task-061.md, task-062.md,
// docs/03-sad/15-module-emr.md Sections 18-19)
//
// Both are Patient-scoped (not Visit-scoped) per task-061's explicit
// guidance, with an optional Visit reference for the encounter the entry
// was recorded during. Medical History is append-only/versioned per the
// "Sistem menyimpan histori perubahan" business rule (SAD Section 18) --
// modeled as immutable rows per category rather than in-place updates, so
// `isActive` marks the current row per (patientId, category) instead of a
// mutable edit. Allergy is a normal auditable record (no versioning
// requirement documented for it).
// ---------------------------------------------------------------------------

// docs/03-sad/15-module-emr.md Section 18 "Categories" -- literal list.
enum MedicalHistoryCategory {
  SYSTEMIC_DISEASE
  HEART_DISEASE
  DIABETES
  HYPERTENSION
  HEPATITIS
  HIV
  BLEEDING_DISORDER
  SURGERY_HISTORY
  PREGNANCY
  HOSPITALIZATION_HISTORY
}

// docs/03-sad/15-module-emr.md Section 19 "Allergy Types" -- literal list.
enum AllergyType {
  DRUG
  FOOD
  LATEX
  MATERIAL
  LOCAL_ANESTHETIC
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

model MedicalHistory {
  id          String                 @id @default(uuid()) @db.Char(36)
  patientId   String                 @map("patient_id") @db.Char(36)
  visitId     String?                @map("visit_id") @db.Char(36)
  category    MedicalHistoryCategory
  description String                 @db.Text
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  createdBy   String?                @map("created_by") @db.Char(36)

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])

  @@index([patientId])
  @@index([visitId])
  @@map("medical_histories")
}

model Allergy {
  id        String          @id @default(uuid()) @db.Char(36)
  patientId String          @map("patient_id") @db.Char(36)
  visitId   String?         @map("visit_id") @db.Char(36)
  type      AllergyType
  allergen  String          @db.VarChar(150)
  severity  AllergySeverity
  reaction  String?         @db.Text
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  createdBy String?         @map("created_by") @db.Char(36)

  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])

  @@index([patientId])
  @@index([visitId])
  @@map("allergies")
}

// ---------------------------------------------------------------------------
// Interactive Odontogram (docs/06-tasks/task-068.md..task-070.md,
// docs/03-sad/15-module-emr.md Part 3.1B/3.1C).
//
// toothNumber uses FDI notation (Part 3.1B Section 11-14): permanent teeth
// 11-18/21-28/31-38/41-48, primary teeth 51-55/61-65/71-75/81-85 (mixed
// dentition supported per Section 14's explicit business rule) -- validated
// against the literal FDI set in application code rather than a DB CHECK
// constraint (no Prisma/MySQL portable way to express it here).
// surface stores a Surface Combination code per Section 18 (e.g. "O", "MO",
// "MOD"), nullable for conditions that are not surface-specific (Crown,
// Missing Tooth, Extraction -- Section 29 "Crown tidak membutuhkan
// Surface"). Entries are append-only per Part 3.1C Section 24 "Tooth
// Versioning" ("Odontogram tidak pernah diperbarui secara langsung"): no
// isActive/update path exists, only new rows; task-069/070 derive "current
// state" and "history" by querying this table rather than a stored flag.
// ---------------------------------------------------------------------------

model OdontogramEntry {
  id               String   @id @default(uuid()) @db.Char(36)
  visitId          String   @map("visit_id") @db.Char(36)
  patientId        String   @map("patient_id") @db.Char(36)
  toothNumber      Int      @map("tooth_number")
  surface          String?  @db.VarChar(10)
  toothConditionId String   @map("tooth_condition_id") @db.Char(36)
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by") @db.Char(36)

  visit          Visit          @relation(fields: [visitId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  toothCondition ToothCondition @relation(fields: [toothConditionId], references: [id])

  @@index([patientId, toothNumber])
  @@index([visitId])
  @@map("odontogram_entries")
}

// ---------------------------------------------------------------------------
// Treatment Planning (docs/06-tasks/task-063.md/task-064.md,
// docs/03-sad/15-module-emr.md Section 22).
//
// Distinct from VisitTreatment (Phase 1 task-053, "performed now" entries
// billed against the current Visit): a TreatmentPlanItem is a *planned*
// future treatment ("Treatment dapat dilakukan pada Visit berikutnya"),
// not yet performed or billed. Priority has no literal enum in the SAD --
// LOW/MEDIUM/HIGH is a reasonable judgment call, documented here since
// the task doesn't name one.
// ---------------------------------------------------------------------------

enum TreatmentPlanPriority {
  LOW
  MEDIUM
  HIGH
}

model TreatmentPlanItem {
  id                      String                @id @default(uuid()) @db.Char(36)
  visitId                 String                @map("visit_id") @db.Char(36)
  patientId               String                @map("patient_id") @db.Char(36)
  treatmentId             String                @map("treatment_id") @db.Char(36)
  toothNumber             Int?                  @map("tooth_number")
  surface                 String?               @db.VarChar(10)
  priority                TreatmentPlanPriority @default(MEDIUM)
  estimatedCost           Decimal               @map("estimated_cost") @db.Decimal(18, 2)
  estimatedDurationMinute Int?                  @map("estimated_duration_minute")
  createdAt               DateTime              @default(now()) @map("created_at")
  createdBy               String?               @map("created_by") @db.Char(36)

  visit        Visit         @relation(fields: [visitId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  treatment    Treatment     @relation(fields: [treatmentId], references: [id])
  reservations Reservation[]

  @@index([visitId])
  @@index([patientId])
  @@map("treatment_plan_items")
}

// ---------------------------------------------------------------------------
// Periodontal Assessment (docs/06-tasks/task-071.md..task-077.md,
// docs/03-sad/15-module-emr.md Part 3.2A-3.2D).
//
// docs/03-sad Part 3.2C Section 24 "Aggregate Design" additionally names
// ToothAssessment/ClinicalNote/Attachment/Version/History as separate
// sub-entities of a fuller DDD aggregate -- not built here since no task in
// this epic (071-077) lists them as a deliverable (ClinicalNote/Attachment
// overlap with Epic Q's Clinical Attachment epic instead), per document
// priority order (Task Specification outranks SAD). task-076's "history"
// is satisfied by listing prior PeriodontalAssessment rows for the same
// patient, the same pattern already used for Medical History/Odontogram,
// rather than a separate versioned history table.
//
// status models the literal 6-state lifecycle from Section 38 for schema
// fidelity, but only two transitions are exposed as use cases in this
// epic: Create (implicit DRAFT) and Lock (-> LOCKED) -- no task defines
// endpoints for the DRAFT->IN_PROGRESS->COMPLETED->REVIEWED steps.
// Measurements are soft-deleted per Section 39's OpenAPI note ("operasi
// DELETE disarankan sebagai Soft Delete").
// ---------------------------------------------------------------------------

enum PeriodontalAssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
  LOCKED
  ARCHIVED
}

// docs/03-sad/15-module-emr.md Part 3.2B Section 11 "Standard Measurement Position".
enum PeriodontalMeasurementPoint {
  MB
  B
  DB
  ML
  L
  DL
}

model PeriodontalAssessment {
  id        String                      @id @default(uuid()) @db.Char(36)
  visitId   String                      @map("visit_id") @db.Char(36)
  patientId String                      @map("patient_id") @db.Char(36)
  doctorId  String                      @map("doctor_id") @db.Char(36)
  status    PeriodontalAssessmentStatus @default(DRAFT)
  lockedAt  DateTime?                   @map("locked_at")
  lockedBy  String?                     @map("locked_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  visit        Visit                    @relation(fields: [visitId], references: [id])
  patient      Patient                  @relation(fields: [patientId], references: [id])
  doctor       Doctor                   @relation(fields: [doctorId], references: [id])
  measurements PeriodontalMeasurement[]

  @@index([visitId])
  @@index([patientId])
  @@map("periodontal_assessments")
}

// docs/03-sad/15-module-emr.md Part 3.2B Sections 12-19: pocketDepth 0-15mm
// (1 decimal), gingivalMargin can be negative up to +-10mm, cal is the
// auto-computed pocketDepth+gingivalMargin (Section 14), plaqueIndex 0-3,
// mobility Grade 0-3, furcation "0"/"I"/"II"/"III" (multiroot teeth only).
model PeriodontalMeasurement {
  id               String                      @id @default(uuid()) @db.Char(36)
  assessmentId     String                      @map("assessment_id") @db.Char(36)
  toothNumber      Int                         @map("tooth_number")
  measurementPoint PeriodontalMeasurementPoint @map("measurement_point")
  pocketDepth      Decimal                     @map("pocket_depth") @db.Decimal(4, 1)
  gingivalMargin   Decimal                     @map("gingival_margin") @db.Decimal(4, 1)
  cal              Decimal                     @db.Decimal(4, 1)
  bleeding         Boolean                     @default(false)
  plaqueIndex      Int?                        @map("plaque_index")
  mobility         Int?
  furcation        String?                     @db.VarChar(5)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  assessment PeriodontalAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@map("periodontal_measurements")
}

// ---------------------------------------------------------------------------
// Referral & Follow Up (docs/06-tasks/task-089.md/task-090.md,
// docs/03-sad/15-module-emr.md Section 26).
//
// FollowUp.priority reuses the TreatmentPlanPriority enum (LOW/MEDIUM/HIGH)
// rather than declaring a duplicate enum with identical values -- Section
// 26 names "Prioritas" as a Follow Up field but gives no literal grade
// list, and Treatment Plan's is the only precedent already in this schema.
// reservationId is set only when the Follow Up was auto-scheduled (task-090
// "Follow Up dapat membuat Reservation otomatis"); the Reservation itself
// is created by Phase 1's CreateReservationUseCase, not duplicated here.
// ---------------------------------------------------------------------------

enum ReferralTargetType {
  SPECIALIST
  HOSPITAL
  LABORATORY
  RADIOLOGY
}

model Referral {
  id         String             @id @default(uuid()) @db.Char(36)
  visitId    String             @map("visit_id") @db.Char(36)
  patientId  String             @map("patient_id") @db.Char(36)
  targetType ReferralTargetType @map("target_type")
  reason     String             @db.Text
  note       String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  visit   Visit   @relation(fields: [visitId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([visitId])
  @@index([patientId])
  @@map("referrals")
}

model FollowUp {
  id            String                @id @default(uuid()) @db.Char(36)
  visitId       String                @map("visit_id") @db.Char(36)
  patientId     String                @map("patient_id") @db.Char(36)
  followUpDate  DateTime              @map("follow_up_date") @db.Date
  note          String?               @db.Text
  priority      TreatmentPlanPriority @default(MEDIUM)
  reservationId String?               @map("reservation_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  visit       Visit        @relation(fields: [visitId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([visitId])
  @@index([patientId])
  @@map("follow_ups")
}

// ---------------------------------------------------------------------------
// Clinical Attachment (docs/06-tasks/task-078.md..task-084.md,
// docs/03-sad/15-module-emr.md Part 3.3A + Section 60 OpenAPI Specification,
// docs/03-sad/02-system-architecture.md Section 27 File Storage
// Architecture).
//
// category uses task-078's own literal 7-value Backend Scope list
// (Clinical Photography/X-Ray/CBCT/Consent/PDF/Video/Other) rather than
// Part 3.3A Section 5's much richer nested taxonomy -- Task Specification
// outranks SAD per document priority order. `attachmentType` is the
// literal multipart field name from Section 60's OpenAPI spec (e.g.
// "Periapical" for an X-Ray), stored free-text since no enum is given.
//
// Versioning: Attachment is the stable parent row (one per logical
// attachment); each upload -- initial or a "correction" re-upload -- adds
// an immutable AttachmentVersion row, and Attachment.currentVersionId is
// repointed to it. Restoring an older version (task-084) just repoints
// currentVersionId again; no version row is ever deleted or mutated, per
// Section 4's Immutable/Versioned characteristics. The actual file bytes
// live outside the database (Section 27.1 "Database hanya menyimpan
// metadata file") in the object-storage abstraction under
// shared/storage/ -- see IObjectStorageService.
// ---------------------------------------------------------------------------

enum AttachmentCategory {
  CLINICAL_PHOTOGRAPHY
  X_RAY
  CBCT
  CONSENT
  PDF
  VIDEO
  OTHER
}

model Attachment {
  id               String             @id @default(uuid()) @db.Char(36)
  visitId          String             @map("visit_id") @db.Char(36)
  patientId        String             @map("patient_id") @db.Char(36)
  category         AttachmentCategory
  attachmentType   String?            @map("attachment_type") @db.VarChar(100)
  currentVersionId String?            @unique @map("current_version_id") @db.Char(36)
  archivedAt       DateTime?          @map("archived_at")
  archivedBy       String?            @map("archived_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  visit          Visit                  @relation(fields: [visitId], references: [id])
  patient        Patient                @relation(fields: [patientId], references: [id])
  versions       AttachmentVersion[]    @relation("AttachmentVersions")
  currentVersion AttachmentVersion?     @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  annotations    AttachmentAnnotation[]

  @@index([visitId])
  @@index([patientId])
  @@map("attachments")
}

// docs/03-sad/02-system-architecture.md Section 27.4 "File Metadata" --
// literal field list (fileName/mimeType/fileSize/bucket/objectKey/
// uploadedBy/uploadedAt), plus storedName/extension/checksum from
// docs/03-sad/15-module-emr.md Part 3.3A Section 7's fuller metadata table.
model AttachmentVersion {
  id            String @id @default(uuid()) @db.Char(36)
  attachmentId  String @map("attachment_id") @db.Char(36)
  versionNumber Int    @map("version_number")
  fileName      String @map("file_name") @db.VarChar(255)
  storedName    String @map("stored_name") @db.VarChar(255)
  extension     String @db.VarChar(20)
  mimeType      String @map("mime_type") @db.VarChar(150)
  fileSize      Int    @map("file_size")
  bucket        String @db.VarChar(100)
  objectKey     String @map("object_key") @db.VarChar(500)
  checksum      String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  attachment Attachment  @relation("AttachmentVersions", fields: [attachmentId], references: [id])
  currentFor Attachment? @relation("CurrentVersion")

  @@unique([attachmentId, versionNumber])
  @@map("attachment_versions")
}

// docs/06-tasks/task-081.md: "persist annotation data (shape/position/text)
// linked to the attachment, without modifying the original immutable file."
model AttachmentAnnotation {
  id           String  @id @default(uuid()) @db.Char(36)
  attachmentId String  @map("attachment_id") @db.Char(36)
  shape        String  @db.VarChar(30)
  positionX    Float   @map("position_x")
  positionY    Float   @map("position_y")
  width        Float?
  height       Float?
  text         String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@index([attachmentId])
  @@map("attachment_annotations")
}

// ---------------------------------------------------------------------------
// Prescription Management (docs/06-tasks/task-065.md/task-066.md,
// docs/03-sad/15-module-emr.md Section 24).
//
// Two documented gaps resolved with explicit user sign-off (task-065's own
// text flags both rather than assuming):
// 1. Allergy conflict is a hard block, not an overridable warning -- no
//    override path/reason field is modeled.
// 2. "Obat berasal dari Master Medicine" is NOT enforced: no task in
//    Phase 1 or 2 builds Medicine master data (it belongs to the
//    not-yet-built Warehouse module, docs/03-sad/18-module-warehouse.md).
//    medicineName is free text; PrescriptionItem has no Medicine FK. This
//    is a deliberate, flagged deferral, not an oversight -- revisit once
//    Warehouse's Medicine entity exists.
// ---------------------------------------------------------------------------

model Prescription {
  id        String @id @default(uuid()) @db.Char(36)
  visitId   String @map("visit_id") @db.Char(36)
  patientId String @map("patient_id") @db.Char(36)
  doctorId  String @map("doctor_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  visit   Visit              @relation(fields: [visitId], references: [id])
  patient Patient            @relation(fields: [patientId], references: [id])
  doctor  Doctor             @relation(fields: [doctorId], references: [id])
  items   PrescriptionItem[]

  @@index([visitId])
  @@index([patientId])
  @@map("prescriptions")
}

// docs/03-sad/15-module-emr.md Section 24 "Information" table -- literal
// field list (Medicine/Dosage/Frequency/Duration/Instruction).
model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Char(36)
  prescriptionId String  @map("prescription_id") @db.Char(36)
  medicineName   String  @map("medicine_name") @db.VarChar(200)
  dosage         String  @db.VarChar(100)
  frequency      String  @db.VarChar(100)
  duration       String  @db.VarChar(100)
  instruction    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Consent Management (docs/06-tasks/task-085.md..task-087.md,
// docs/03-sad/15-module-emr.md Part 3.3D).
//
// Part 3.3D describes a much larger enterprise system (PDF generation with
// QR verification, OTP patient identity verification, AES encryption at
// rest, multiple signature capture types) than task-085..087 actually ask
// for -- none of that is a listed deliverable in any of the three tasks,
// so it is NOT built here, per document priority order (Task Specification
// outranks SAD), the same scoping-down already applied to Periodontal
// Assessment and Clinical Attachment. category uses task-085's own literal
// 3-value list (General/Clinical/Surgical), not Section 39's fuller
// 6-category list (which also includes Orthodontic/Esthetic/Publication).
//
// No hard gate: recording a Treatment (Phase 1 task-053) is NOT blocked by
// a missing signed Consent -- Section 48's "wajib memiliki" rule never
// states a system-enforcement mechanic (no "system rejects" wording, no
// error code, no test scenario), and per explicit user sign-off this ships
// as an independent feature without touching RecordTreatmentUseCase.
//
// "PDF Generation" (Section 42) is replaced with a minimal text document
// (no PDF library is approved) uploaded through the existing
// UploadAttachmentUseCase (task-078) with category CONSENT, in-process
// rather than via multer/HTTP -- signedAttachmentId points at it.
// ---------------------------------------------------------------------------

enum ConsentCategory {
  GENERAL
  CLINICAL
  SURGICAL
}

model ConsentTemplate {
  id       String          @id @default(uuid()) @db.Char(36)
  category ConsentCategory
  title    String          @db.VarChar(200)
  body     String          @db.Text
  isActive Boolean         @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  consents Consent[]

  @@map("consent_templates")
}

// docs/03-sad/15-module-emr.md Part 3.3D Section 40 "Signature Metadata" +
// "Guardian Support" -- signerRelationship literal list.
enum ConsentSignerRelationship {
  SELF
  FATHER
  MOTHER
  HUSBAND
  WIFE
  LEGAL_GUARDIAN
}

model Consent {
  id                 String                     @id @default(uuid()) @db.Char(36)
  templateId         String                     @map("template_id") @db.Char(36)
  patientId          String                     @map("patient_id") @db.Char(36)
  visitId            String                     @map("visit_id") @db.Char(36)
  doctorId           String                     @map("doctor_id") @db.Char(36)
  procedure          String                     @db.VarChar(200)
  signedAt           DateTime?                  @map("signed_at")
  signerName         String?                    @map("signer_name") @db.VarChar(150)
  signerRelationship ConsentSignerRelationship? @map("signer_relationship")
  signatureData      String?                    @map("signature_data") @db.Text
  hash               String?                    @db.VarChar(64)
  signedAttachmentId String?                    @map("signed_attachment_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  template ConsentTemplate @relation(fields: [templateId], references: [id])
  patient  Patient         @relation(fields: [patientId], references: [id])
  visit    Visit           @relation(fields: [visitId], references: [id])
  doctor   Doctor          @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([visitId])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Medical Certificate (docs/06-tasks/task-088.md,
// docs/03-sad/15-module-emr.md Section 25).
//
// Section 25 is terse: only certificate types + 3 business rules, no field
// list beyond that. `content` (the certificate body/statement) is a
// reasonable minimal addition -- a certificate needs some text -- not
// invented business logic. certificateNumber follows the same
// date-prefixed sequential-counter format already used for Reservation
// Numbers ("RSV-YYYYMMDD-0001"), since no literal format is specified.
// "Hanya Doctor yang dapat menerbitkan" is enforced two ways: the
// emr.certificate.issue permission (RBAC, seeded to DOCTOR only, the same
// mechanism every other "(Doctor role)" task in this project relies on)
// AND a use-case-level check that the actor has a linked Doctor profile
// (IssueMedicalCertificateUseCase), since task-088 explicitly requires a
// unit test for "only a Doctor-role user can issue."
// ---------------------------------------------------------------------------

enum MedicalCertificateType {
  FIT_TO_WORK
  SICK_LEAVE
  MEDICAL_STATEMENT
  DENTAL_TREATMENT_CERTIFICATE
}

model MedicalCertificate {
  id                String                 @id @default(uuid()) @db.Char(36)
  certificateNumber String                 @unique @map("certificate_number") @db.VarChar(30)
  visitId           String                 @map("visit_id") @db.Char(36)
  patientId         String                 @map("patient_id") @db.Char(36)
  doctorId          String                 @map("doctor_id") @db.Char(36)
  certificateType   MedicalCertificateType @map("certificate_type")
  content           String                 @db.Text
  issuedAt          DateTime               @default(now()) @map("issued_at")
  attachmentId      String                 @map("attachment_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  visit   Visit   @relation(fields: [visitId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([visitId])
  @@map("medical_certificates")
}

// ---------------------------------------------------------------------------
// Billing Basic (docs/06-tasks/task-054.md..task-058.md,
// docs/03-sad/16-module-billing.md Sections 6/9/10/12)
//
// Epic J originally scaffolded a DRAFT/ISSUED/CANCELLED/CLOSED status enum
// plus a separate paymentStatus field before Epic H's task docs had been
// read. task-054/057/058 (priority 2, outranking the SAD) describe a single
// status progression -- "Unpaid/Open" on generation, "Partially Paid /
// Paid" as payments are applied, then "Closed" -- which is the SAD's own
// InvoicePaymentStatus-shaped list (Section 12 "Invoice Status" adds
// Pending Payment/Cancelled/Void, which no Phase 1 task exercises; those
// remain a documented gap for a later phase). Collapsed to one enum/field
// matching the literal task language instead of carrying two half-matching
// status representations.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CLOSED
}

model Invoice {
  id          String        @id @default(uuid()) @db.Char(36)
  invoiceNo   String        @unique @map("invoice_no") @db.VarChar(30)
  visitId     String        @unique @map("visit_id") @db.Char(36)
  patientId   String        @map("patient_id") @db.Char(36)
  branchId    String        @map("branch_id") @db.Char(36)
  invoiceDate DateTime      @default(now()) @map("invoice_date")
  subtotal    Decimal       @db.Decimal(18, 2)
  discount    Decimal       @default(0) @db.Decimal(18, 2)
  tax         Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal  Decimal       @map("grand_total") @db.Decimal(18, 2)
  paidAmount  Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  status      InvoiceStatus @default(UNPAID)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  visit    Visit         @relation(fields: [visitId], references: [id])
  patient  Patient       @relation(fields: [patientId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([patientId])
  @@index([branchId])
  @@index([status])
  @@map("invoices")
}

// docs/03-sad/16-module-billing.md `billing_invoice_items`. Phase 1 only
// produces line items from Visit Treatment entries (task-054), so
// `referenceType` is always "Treatment" for now; the column is kept
// String-typed (not enum-restricted) because the SAD documents five other
// reference types (Medicine/Consumable/Laboratory/Radiology/Manual Charge)
// that belong to later phases.
model InvoiceItem {
  id            String   @id @default(uuid()) @db.Char(36)
  invoiceId     String   @map("invoice_id") @db.Char(36)
  referenceType String   @map("reference_type") @db.VarChar(30)
  referenceId   String   @map("reference_id") @db.Char(36)
  itemName      String   @map("item_name") @db.VarChar(255)
  quantity      Decimal  @db.Decimal(10, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  tax           Decimal  @default(0) @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String   @id @default(uuid()) @db.Char(36)
  invoiceId       String   @map("invoice_id") @db.Char(36)
  paymentMethodId String   @map("payment_method_id") @db.Char(36)
  paymentDate     DateTime @default(now()) @map("payment_date")
  amount          Decimal  @db.Decimal(18, 2)
  referenceNo     String?  @map("reference_no") @db.VarChar(100)
  receivedBy      String?  @map("received_by") @db.Char(36)
  note            String?  @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Cross-Cutting: Audit Trail (docs/06-tasks/task-006.md, docs/03-sad/02-system-architecture.md Section 20.4)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Master Data: Item Category & Unit (docs/03-sad/18-module-warehouse.md
// Section 6.1's literal Create Item example requires `categoryId`/`unitId`;
// docs/04-ai-contract/07-module-contract.md MOD-013 lists "Unit" as a
// Master Data-owned reference entity generically, and Item Category is the
// same reference-data shape as the existing TreatmentCategory (also
// Master Data-owned) -- neither is invented business logic, both are the
// minimal FK targets the Item entity's own documented fields require.
// No dedicated CRUD endpoint exists for either in Phase 3's task list
// (task-095-209); only the tables + minimal seed rows are in scope here.
// ---------------------------------------------------------------------------

model ItemCategory {
  id           String  @id @default(uuid()) @db.Char(36)
  categoryCode String  @unique @map("category_code") @db.VarChar(30)
  categoryName String  @map("category_name") @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  items Item[]

  @@map("item_categories")
}

model Unit {
  id       String  @id @default(uuid()) @db.Char(36)
  unitCode String  @unique @map("unit_code") @db.VarChar(20)
  unitName String  @map("unit_name") @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  items Item[]

  @@map("units")
}

// ---------------------------------------------------------------------------
// Warehouse Module (docs/03-sad/18-module-warehouse.md, Epic V Foundation
// task-095-103). Warehouse owns Item, WarehouseLocation, WarehouseStock,
// StockTransaction per docs/04-ai-contract/07-module-contract.md MOD-078/
// MOD-079. Table names follow SAD Section 5.1's literal domain-term
// physical naming (items, suppliers, warehouses, warehouse_stocks,
// stock_transactions), consistent with this codebase's existing
// unprefixed plural-noun convention (treatments, patients, ...).
// ---------------------------------------------------------------------------

/// docs/03-sad/18-module-warehouse.md Section 5.2 "items": item_code unique
/// and immutable once transacted (enforced in application layer, not a DB
/// trigger -- consistent with how this codebase enforces business
/// invariants elsewhere, e.g. Attachment immutability).
model Item {
  id              String  @id @default(uuid()) @db.Char(36)
  itemCode        String  @unique @map("item_code") @db.VarChar(30)
  itemName        String  @map("item_name") @db.VarChar(150)
  categoryId      String  @map("category_id") @db.Char(36)
  unitId          String  @map("unit_id") @db.Char(36)
  minimumStock    Decimal @default(0) @map("minimum_stock") @db.Decimal(18, 2)
  purchasePrice   Decimal @default(0) @map("purchase_price") @db.Decimal(18, 2)
  sellingPrice    Decimal @default(0) @map("selling_price") @db.Decimal(18, 2)
  isConsumable    Boolean @default(true) @map("is_consumable")
  isBatchTracked  Boolean @default(false) @map("is_batch_tracked")
  isExpiryTracked Boolean @default(false) @map("is_expiry_tracked")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  category             ItemCategory          @relation(fields: [categoryId], references: [id])
  unit                 Unit                  @relation(fields: [unitId], references: [id])
  stocks               WarehouseStock[]
  stockTransactions    StockTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  stockTransferItems   StockTransferItem[]
  stockAdjustmentItems StockAdjustmentItem[]
  stockReservations    StockReservation[]
  stockOpnameItems     StockOpnameItem[]
  itemBatches          ItemBatch[]

  @@index([categoryId])
  @@index([isActive])
  @@map("items")
}

/// docs/03-sad/18-module-warehouse.md Section 5.2: supplier_code, name, PIC,
/// phone, address, tax, active flag, non-sensitive payment metadata.
model Supplier {
  id           String  @id @default(uuid()) @db.Char(36)
  supplierCode String  @unique @map("supplier_code") @db.VarChar(30)
  supplierName String  @map("supplier_name") @db.VarChar(150)
  picName      String? @map("pic_name") @db.VarChar(100)
  phone        String? @db.VarChar(30)
  address      String? @db.Text
  taxNumber    String? @map("tax_number") @db.VarChar(50)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

/// docs/03-sad/18-module-warehouse.md Section 5.2: warehouses stores
/// branch_id, code, name, location, type, active flag, manager reference.
/// Named `WarehouseLocation` (not `Warehouse`) to avoid clashing with the
/// module name, matching task-100's own entity name.
model WarehouseLocation {
  id            String  @id @default(uuid()) @db.Char(36)
  branchId      String  @map("branch_id") @db.Char(36)
  locationCode  String  @map("location_code") @db.VarChar(30)
  locationName  String  @map("location_name") @db.VarChar(150)
  locationType  String  @default("MAIN") @map("location_type") @db.VarChar(30)
  address       String? @db.Text
  managerUserId String? @map("manager_user_id") @db.Char(36)
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  branch            Branch             @relation(fields: [branchId], references: [id])
  stocks            WarehouseStock[]
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  transfersOut      StockTransfer[]    @relation("TransferSource")
  transfersIn       StockTransfer[]    @relation("TransferDestination")
  adjustments       StockAdjustment[]
  reservations      StockReservation[]
  stockOpnames      StockOpname[]
  itemBatches       ItemBatch[]

  @@unique([branchId, locationCode])
  @@index([branchId])
  @@map("warehouses")
}

/// docs/03-sad/18-module-warehouse.md Section 5.4: current/reserved/
/// available stock per warehouse-item combination. `availableStock` is
/// always server-computed (current - reserved), never accepted from a
/// client -- enforced in the application layer since Prisma has no
/// generated-column support used elsewhere in this schema. `version` is
/// for optimistic concurrency per Section 3.5 Rule 1.
model WarehouseStock {
  id                String    @id @default(uuid()) @db.Char(36)
  warehouseId       String    @map("warehouse_id") @db.Char(36)
  itemId            String    @map("item_id") @db.Char(36)
  currentStock      Decimal   @default(0) @map("current_stock") @db.Decimal(18, 2)
  reservedStock     Decimal   @default(0) @map("reserved_stock") @db.Decimal(18, 2)
  availableStock    Decimal   @default(0) @map("available_stock") @db.Decimal(18, 2)
  minimumStock      Decimal?  @map("minimum_stock") @db.Decimal(18, 2)
  version           Int       @default(0)
  lastTransactionAt DateTime? @map("last_transaction_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  warehouse WarehouseLocation @relation(fields: [warehouseId], references: [id])
  item      Item              @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@index([itemId])
  @@map("warehouse_stocks")
}

enum WarehouseStockTransactionType {
  PURCHASE
  SALE
  TREATMENT
  ADJUSTMENT
  TRANSFER
  OPNAME
  RETURN
  RESERVATION
  RELEASE_RESERVATION
}

/// docs/03-sad/18-module-warehouse.md Section 5.5: immutable stock ledger.
/// `batchId` now carries a real FK to `ItemBatch` (built in Epic Y,
/// task-127-135) -- Epic V/W/X posted transactions with `batchId` left
/// null since the model didn't exist yet; Epic Y's PostGoodsReceiptUseCase
/// is the first writer to populate it. The idempotency unique key follows
/// Section 5.7 literally; MySQL treats NULL as distinct in unique indexes,
/// so writers posting a non-batch transaction (batchId null) MUST
/// additionally duplicate-check at the application layer per Section 3.5
/// Rule 4 -- documented here for Epic Z implementers.
model StockTransaction {
  id                String                        @id @default(uuid()) @db.Char(36)
  transactionNumber String                        @unique @map("transaction_number") @db.VarChar(30)
  warehouseId       String                        @map("warehouse_id") @db.Char(36)
  itemId            String                        @map("item_id") @db.Char(36)
  batchId           String?                       @map("batch_id") @db.Char(36)
  transactionType   WarehouseStockTransactionType @map("transaction_type")
  referenceType     String                        @map("reference_type") @db.VarChar(50)
  referenceId       String                        @map("reference_id") @db.Char(36)
  qtyIn             Decimal                       @default(0) @map("qty_in") @db.Decimal(18, 2)
  qtyOut            Decimal                       @default(0) @map("qty_out") @db.Decimal(18, 2)
  balance           Decimal                       @db.Decimal(18, 2)
  transactionDate   DateTime                      @map("transaction_date")
  performedBy       String                        @map("performed_by") @db.Char(36)
  approvedBy        String?                       @map("approved_by") @db.Char(36)
  notes             String?                       @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  warehouse WarehouseLocation @relation(fields: [warehouseId], references: [id])
  item      Item              @relation(fields: [itemId], references: [id])
  batch     ItemBatch?        @relation(fields: [batchId], references: [id])

  @@unique([referenceType, referenceId, transactionType, itemId, batchId], name: "idempotency_key")
  @@index([warehouseId, itemId, transactionDate])
  @@index([referenceType, referenceId])
  @@map("stock_transactions")
}

// ---------------------------------------------------------------------------
// Warehouse Module: Procurement (docs/03-sad/18-module-warehouse.md UC-WHS-001/
// UC-WHS-002, Epic W task-104-114). Table names follow the domain terms
// PurchaseOrder/GoodsReceipt (no `warehouse_` prefix), consistent with Epic
// V's naming choice for Item/Supplier/WarehouseLocation -- Section 5.1
// explicitly says "Implementasi memilih satu nama fisik yang konsisten";
// this keeps one physical-naming convention across the whole module rather
// than mixing prefixed/unprefixed names across epics.
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_RECEIVED
  RECEIVED
}

/// docs/03-sad/18-module-warehouse.md Section 3.7 state machine; UC-WHS-001.
model PurchaseOrder {
  id                  String              @id @default(uuid()) @db.Char(36)
  purchaseOrderNumber String              @unique @map("purchase_order_number") @db.VarChar(30)
  supplierId          String              @map("supplier_id") @db.Char(36)
  branchId            String              @map("branch_id") @db.Char(36)
  warehouseId         String              @map("warehouse_id") @db.Char(36)
  orderDate           DateTime            @default(now()) @map("order_date")
  expectedDate        DateTime?           @map("expected_date")
  status              PurchaseOrderStatus @default(DRAFT)
  totalAmount         Decimal             @default(0) @map("total_amount") @db.Decimal(18, 2)

  submittedAt     DateTime? @map("submitted_at")
  approvedBy      String?   @map("approved_by") @db.Char(36)
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by") @db.Char(36)
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  cancelledBy     String?   @map("cancelled_by") @db.Char(36)
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Char(36)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Char(36)

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  branch        Branch              @relation(fields: [branchId], references: [id])
  warehouse     WarehouseLocation   @relation(fields: [warehouseId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

/// docs/03-sad/18-module-warehouse.md Section 3.2: "Kuantitas diterima tidak
/// melebihi ordered kecuali approval over-receipt" -- `quantityReceived` is
/// the running total across all posted Goods Receipts against this line.
model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Char(36)
  purchaseOrderId  String  @map("purchase_order_id") @db.Char(36)
  itemId           String  @map("item_id") @db.Char(36)
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 2)
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)
  subtotal         Decimal @db.Decimal(18, 2)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
}

/// docs/03-sad/18-module-warehouse.md UC-WHS-002: "Hanya receipt yang
/// posted menambah stock ledger." Posting is the transaction boundary
/// (task-114); creation (task-112) only records what was physically
/// received, unposted.
model GoodsReceipt {
  id                 String             @id @default(uuid()) @db.Char(36)
  goodsReceiptNumber String             @unique @map("goods_receipt_number") @db.VarChar(30)
  purchaseOrderId    String             @map("purchase_order_id") @db.Char(36)
  warehouseId        String             @map("warehouse_id") @db.Char(36)
  receiptDate        DateTime           @map("receipt_date")
  supplierDocumentNo String?            @map("supplier_document_no") @db.VarChar(50)
  status             GoodsReceiptStatus @default(DRAFT)
  postedBy           String?            @map("posted_by") @db.Char(36)
  postedAt           DateTime?          @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     WarehouseLocation  @relation(fields: [warehouseId], references: [id])
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@map("goods_receipts")
}

/// docs/03-sad/18-module-warehouse.md Section 6.2 literal Create Goods
/// Receipt example: batchNumber/expiryDate captured here per line.
/// PostGoodsReceiptUseCase (Epic Y, task-134) upserts an `ItemBatch` row
/// from these fields when the item `isBatchTracked`, linking
/// `StockTransaction.batchId`.
model GoodsReceiptItem {
  id                  String    @id @default(uuid()) @db.Char(36)
  goodsReceiptId      String    @map("goods_receipt_id") @db.Char(36)
  purchaseOrderItemId String    @map("purchase_order_item_id") @db.Char(36)
  itemId              String    @map("item_id") @db.Char(36)
  quantity            Decimal   @db.Decimal(18, 2)
  unitCost            Decimal   @map("unit_cost") @db.Decimal(18, 2)
  batchNumber         String?   @map("batch_number") @db.VarChar(50)
  expiryDate          DateTime? @map("expiry_date")

  createdAt DateTime @default(now()) @map("created_at")

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// Warehouse Module: Stock Movement (docs/03-sad/18-module-warehouse.md
// UC-WHS-004 Transfer/UC-WHS-005 Adjustment/UC-WHS-007 Reserve-Release,
// Epic X task-115-126). Table names follow the same unprefixed
// domain-term convention as Epic V/W.
// ---------------------------------------------------------------------------

enum StockTransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISPATCHED
  RECEIVED
}

/// docs/03-sad/18-module-warehouse.md UC-WHS-004 flowchart: Create ->
/// Approve -> Dispatch (reserve/out source) -> Receive (in destination) ->
/// Post paired transactions -> Publish event. Two distinct FKs to
/// WarehouseLocation require named relations to disambiguate.
model StockTransfer {
  id                     String              @id @default(uuid()) @db.Char(36)
  transferNumber         String              @unique @map("transfer_number") @db.VarChar(30)
  sourceWarehouseId      String              @map("source_warehouse_id") @db.Char(36)
  destinationWarehouseId String              @map("destination_warehouse_id") @db.Char(36)
  status                 StockTransferStatus @default(DRAFT)
  notes                  String?             @db.Text

  submittedAt  DateTime? @map("submitted_at")
  approvedBy   String?   @map("approved_by") @db.Char(36)
  approvedAt   DateTime? @map("approved_at")
  dispatchedBy String?   @map("dispatched_by") @db.Char(36)
  dispatchedAt DateTime? @map("dispatched_at")
  receivedBy   String?   @map("received_by") @db.Char(36)
  receivedAt   DateTime? @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  sourceWarehouse      WarehouseLocation   @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse WarehouseLocation   @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  items                StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String  @id @default(uuid()) @db.Char(36)
  transferId String  @map("transfer_id") @db.Char(36)
  itemId     String  @map("item_id") @db.Char(36)
  quantity   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

enum StockAdjustmentDirection {
  IN
  OUT
}

enum StockAdjustmentStatus {
  DRAFT
  APPROVED
  POSTED
}

/// docs/03-sad/18-module-warehouse.md Section 5.6: "stock_adjustments
/// memuat nomor, direction, item/batch/warehouse, quantity, reason code,
/// evidence, status, linked stock transaction, requester/approver" --
/// `direction` modeled at the header level (one adjustment = one
/// direction), matching that literal flat column list rather than
/// allowing mixed-direction line items, which the SAD text doesn't
/// describe.
model StockAdjustment {
  id               String                   @id @default(uuid()) @db.Char(36)
  adjustmentNumber String                   @unique @map("adjustment_number") @db.VarChar(30)
  warehouseId      String                   @map("warehouse_id") @db.Char(36)
  direction        StockAdjustmentDirection
  reasonCode       String                   @map("reason_code") @db.VarChar(50)
  status           StockAdjustmentStatus    @default(DRAFT)

  approvedBy String?   @map("approved_by") @db.Char(36)
  approvedAt DateTime? @map("approved_at")
  postedBy   String?   @map("posted_by") @db.Char(36)
  postedAt   DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  warehouse WarehouseLocation     @relation(fields: [warehouseId], references: [id])
  items     StockAdjustmentItem[]

  @@index([warehouseId])
  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String  @id @default(uuid()) @db.Char(36)
  adjustmentId String  @map("adjustment_id") @db.Char(36)
  itemId       String  @map("item_id") @db.Char(36)
  quantity     Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id])
  item       Item            @relation(fields: [itemId], references: [id])

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
}

/// docs/03-sad/18-module-warehouse.md UC-WHS-007: "Reservation menambah
/// reserved_stock dan mengurangi available_stock tanpa mengurangi
/// current_stock." `referenceType`/`referenceId` follow the same
/// MovementReference value object shape as StockTransaction.
model StockReservation {
  id            String                 @id @default(uuid()) @db.Char(36)
  warehouseId   String                 @map("warehouse_id") @db.Char(36)
  itemId        String                 @map("item_id") @db.Char(36)
  quantity      Decimal                @db.Decimal(18, 2)
  referenceType String                 @map("reference_type") @db.VarChar(50)
  referenceId   String                 @map("reference_id") @db.Char(36)
  status        StockReservationStatus @default(ACTIVE)

  releasedBy String?   @map("released_by") @db.Char(36)
  releasedAt DateTime? @map("released_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  warehouse WarehouseLocation @relation(fields: [warehouseId], references: [id])
  item      Item              @relation(fields: [itemId], references: [id])

  @@index([warehouseId, itemId])
  @@index([status])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Warehouse Module: Stock Opname & Batch (docs/03-sad/18-module-warehouse.md
// UC-WHS-006, Epic Y task-127-135). Table names follow the module's own
// literal Section 5.1 dictionary (`stock_opnames`, `stock_opname_items`,
// `item_batches`), consistent with Epic V/W/X's naming choice.
// ---------------------------------------------------------------------------

/// docs/03-sad/18-module-warehouse.md Section 5.6 literal status list.
/// task-130/task-131 split UC-WHS-006's narrative step 1 ("system takes a
/// balance snapshot when the opname opens") into two task-spec endpoints:
/// Create (draft, scope only, no snapshot yet) and Start Count (freezes
/// the systemQuantity snapshot, DRAFT -> COUNTING) -- task-130's own AC
/// ("System quantity snapshot is immutable once counting starts") is the
/// literal source of truth here per this project's task-spec-over-SAD-
/// narrative priority, already established for other Epic X/Y splits.
enum StockOpnameStatus {
  DRAFT
  COUNTING
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
}

/// docs/03-sad/18-module-warehouse.md Section 5.6: "stock_opnames memuat
/// nomor, branch/warehouse, tanggal, status, snapshot time, catatan, dan
/// approval data." `opnameDate` + `warehouseId` back the
/// `WHS_OPNAME_ALREADY_ACTIVE` check (Section 5.7's "unique active opname
/// scope"), enforced at the application layer (not a DB unique index,
/// since "active" excludes POSTED/REJECTED -- MySQL has no native partial
/// unique index) -- same pattern as this module's other segregation/status
/// guards enforced in the use-case layer.
model StockOpname {
  id           String            @id @default(uuid()) @db.Char(36)
  opnameNumber String            @unique @map("opname_number") @db.VarChar(30)
  warehouseId  String            @map("warehouse_id") @db.Char(36)
  opnameDate   DateTime          @map("opname_date") @db.Date
  status       StockOpnameStatus @default(DRAFT)
  notes        String?           @db.Text
  snapshotAt   DateTime?         @map("snapshot_at")

  submittedAt DateTime? @map("submitted_at")
  approvedBy  String?   @map("approved_by") @db.Char(36)
  approvedAt  DateTime? @map("approved_at")
  postedBy    String?   @map("posted_by") @db.Char(36)
  postedAt    DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  warehouse WarehouseLocation @relation(fields: [warehouseId], references: [id])
  items     StockOpnameItem[]

  @@index([warehouseId, opnameDate])
  @@index([status])
  @@map("stock_opnames")
}

/// docs/03-sad/18-module-warehouse.md Section 5.6: "stock_opname_items
/// menyimpan item/batch, system quantity, physical quantity, variance,
/// reason, dan proof." `systemQuantity`/`physicalQuantity`/`variance` stay
/// nullable until Start Count / Submit populate them respectively --
/// task-131's own text ("Submit counted quantities... computing variance
/// per line") is read as the physical count arriving in the Submit
/// request body itself, since no separate per-line "record count"
/// endpoint exists anywhere in task-127-135's literal API table
/// (docs/03-sad/18-module-warehouse.md Section 6.4) or task-129's PATCH
/// (whose own AC explicitly blocks edits once counting has started).
model StockOpnameItem {
  id               String   @id @default(uuid()) @db.Char(36)
  opnameId         String   @map("opname_id") @db.Char(36)
  itemId           String   @map("item_id") @db.Char(36)
  systemQuantity   Decimal? @map("system_quantity") @db.Decimal(18, 2)
  physicalQuantity Decimal? @map("physical_quantity") @db.Decimal(18, 2)
  variance         Decimal? @db.Decimal(18, 2)
  notes            String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  opname StockOpname @relation(fields: [opnameId], references: [id])
  item   Item        @relation(fields: [itemId], references: [id])

  @@index([opnameId])
  @@map("stock_opname_items")
}

/// docs/03-sad/18-module-warehouse.md Section 5.4 literal status list
/// (active, quarantined, expired, depleted).
enum ItemBatchStatus {
  ACTIVE
  QUARANTINED
  EXPIRED
  DEPLETED
}

/// docs/03-sad/18-module-warehouse.md Section 5.4 `item_batches`: key
/// alokasi batch (warehouse_id, item_id, batch_number), received/expiry
/// date, initial/remaining quantity (not negative), status. Populated by
/// PostGoodsReceiptUseCase (task-114/task-134) when the item is
/// isBatchTracked; `remainingQuantity` is decremented by future
/// consumption/transfer/quarantine epics, never by direct client write.
model ItemBatch {
  id                String          @id @default(uuid()) @db.Char(36)
  warehouseId       String          @map("warehouse_id") @db.Char(36)
  itemId            String          @map("item_id") @db.Char(36)
  batchNumber       String          @map("batch_number") @db.VarChar(50)
  receivedDate      DateTime        @map("received_date") @db.Date
  expiryDate        DateTime?       @map("expiry_date") @db.Date
  initialQuantity   Decimal         @map("initial_quantity") @db.Decimal(18, 2)
  remainingQuantity Decimal         @map("remaining_quantity") @db.Decimal(18, 2)
  status            ItemBatchStatus @default(ACTIVE)

  quarantinedBy String?   @map("quarantined_by") @db.Char(36)
  quarantinedAt DateTime? @map("quarantined_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)

  warehouse         WarehouseLocation  @relation(fields: [warehouseId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  stockTransactions StockTransaction[]

  @@unique([warehouseId, itemId, batchNumber])
  @@index([itemId])
  @@index([expiryDate])
  @@index([status])
  @@map("item_batches")
}

// ---------------------------------------------------------------------------
// Finance Module: Chart of Accounts (docs/03-sad/17-module-finance.md
// Section 6.1, Epic AB task-143-145). Table name follows the SAD's own
// literal Section 5.1 dictionary (`accounts`, unprefixed) rather than the
// task files' `finance_accounts` phrasing, consistent with the same
// implementer's-choice permission already exercised throughout the
// Warehouse module (SAD Section 5.1 there: "Implementasi memilih satu
// nama fisik yang konsisten melalui migration").
// ---------------------------------------------------------------------------

enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinanceNormalBalance {
  DEBIT
  CREDIT
}

/// docs/03-sad/17-module-finance.md Section 3.3/5.2: `branchId` null means
/// a shared template account; otherwise it's branch-effective. Section
/// 5.2 requires code "unique per branch/template scope" -- MySQL treats
/// NULL as distinct in a unique index, so a `(branchId, code)` DB
/// constraint alone would NOT catch two shared-template (branchId=null)
/// accounts sharing a code; CreateAccountUseCase additionally checks via
/// `findByBranchAndCode` before insert, the same documented pattern
/// already used for StockTransaction's idempotency key gap.
/// No `deletedAt`/soft-delete columns: task-145's own AC says accounts
/// are deactivated (isActive=false), never hard-deleted -- Section 5.2's
/// literal accounts table has no deleted_at column, unlike most other
/// tables in this schema.
model Account {
  id            String               @id @default(uuid()) @db.Char(36)
  branchId      String?              @map("branch_id") @db.Char(36)
  code          String               @db.VarChar(30)
  name          String               @db.VarChar(150)
  accountType   FinanceAccountType   @map("account_type")
  normalBalance FinanceNormalBalance @map("normal_balance")
  parentId      String?              @map("parent_id") @db.Char(36)
  isPostable    Boolean              @default(true) @map("is_postable")
  isActive      Boolean              @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch         Branch?               @relation(fields: [branchId], references: [id])
  parent         Account?              @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]             @relation("AccountHierarchy")
  lines          JournalLine[]
  cashAccounts   CashAccount[]
  expenses       Expense[]
  feeSettlements DoctorFeeSettlement[]

  @@unique([branchId, code])
  @@index([parentId])
  @@index([accountType])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Finance Module: Journals & Financial Period (docs/03-sad/17-module-
// finance.md UC-FIN-002/UC-FIN-007, Epic AC task-146-152 + task-168
// folded in early per this phase's own documented sequencing note:
// Post Journal's FIN_PERIOD_CLOSED check needs FinancialPeriod to exist,
// so task-168 (Financial Period entity/Create/List, normally Epic AE)
// is built now; Lock/Close/Reopen (task-169-171) remain in Epic AE.
// Table names follow the SAD's own literal Section 5.1 dictionary
// (`journal_entries`, `journal_details`, `financial_periods`), the same
// implementer's-choice permission already exercised throughout this
// phase.
// ---------------------------------------------------------------------------

enum FinanceJournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOIDED
}

/// docs/03-sad/17-module-finance.md Section 5.2/3.3: `journalNo` is
/// "generated, immutable after posting" -- task-146's own AC says
/// "journalNumber is generated immutably once posted", read literally as
/// generated AT posting time (not at draft creation), unlike this
/// codebase's Warehouse-module precedent (PO/GR numbers generate at
/// creation). `journalNo` therefore stays null while draft.
model Journal {
  id            String               @id @default(uuid()) @db.Char(36)
  journalNo     String?              @unique @map("journal_no") @db.VarChar(40)
  branchId      String               @map("branch_id") @db.Char(36)
  journalDate   DateTime             @map("journal_date") @db.Date
  referenceType String?              @map("reference_type") @db.VarChar(50)
  referenceId   String?              @map("reference_id") @db.Char(36)
  postingType   String?              @map("posting_type") @db.VarChar(40)
  description   String               @db.VarChar(500)
  status        FinanceJournalStatus @default(DRAFT)

  postedAt      DateTime? @map("posted_at")
  postedBy      String?   @map("posted_by") @db.Char(36)
  voidedAt      DateTime? @map("voided_at")
  voidedBy      String?   @map("voided_by") @db.Char(36)
  voidReason    String?   @map("void_reason") @db.Text
  reversalOfId  String?   @unique @map("reversal_of_id") @db.Char(36)
  reverseReason String?   @map("reverse_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch        Branch               @relation(fields: [branchId], references: [id])
  lines         JournalLine[]
  reversalOf    Journal?             @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy    Journal?             @relation("JournalReversal")
  expense       Expense?
  feeSettlement DoctorFeeSettlement?

  @@unique([referenceType, referenceId, postingType], name: "idempotency_key")
  @@index([branchId, journalDate, status])
  @@map("journal_entries")
}

/// docs/03-sad/17-module-finance.md Section 5.2: "Exactly one [of debit/
/// credit] is positive" -- enforced in the application layer, mirroring
/// Warehouse's StockTransaction qty_in/qty_out convention.
model JournalLine {
  id           String  @id @default(uuid()) @db.Char(36)
  journalId    String  @map("journal_entry_id") @db.Char(36)
  accountId    String  @map("account_id") @db.Char(36)
  debit        Decimal @default(0) @db.Decimal(18, 2)
  credit       Decimal @default(0) @db.Decimal(18, 2)
  description  String? @db.VarChar(500)
  costCenterId String? @map("cost_center_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")

  journal Journal @relation(fields: [journalId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, journalId])
  @@map("journal_details")
}

enum FinancialPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

/// docs/03-sad/17-module-finance.md Section 5.2/3.2: "Date ranges for
/// active periods must not overlap within a branch" -- checked at the
/// application layer (OPEN/LOCKED periods only; a CLOSED period's range
/// may legitimately be superseded). Section 3.7's state machine allows
/// Open -> Locked -> Closed and Closed -> Open (reopen), but task-169-171
/// (Lock/Close/Reopen) are Epic AE's own scope; only Create/List (task-168)
/// land here.
model FinancialPeriod {
  id         String                @id @default(uuid()) @db.Char(36)
  branchId   String                @map("branch_id") @db.Char(36)
  periodName String                @map("period_name") @db.VarChar(100)
  startDate  DateTime              @map("start_date") @db.Date
  endDate    DateTime              @map("end_date") @db.Date
  status     FinancialPeriodStatus @default(OPEN)

  lockedBy     String?   @map("locked_by") @db.Char(36)
  lockedAt     DateTime? @map("locked_at")
  closedBy     String?   @map("closed_by") @db.Char(36)
  closedAt     DateTime? @map("closed_at")
  reopenedBy   String?   @map("reopened_by") @db.Char(36)
  reopenedAt   DateTime? @map("reopened_at")
  reopenReason String?   @map("reopen_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, startDate, endDate])
  @@index([status])
  @@map("financial_periods")
}

// ---------------------------------------------------------------------------
// Finance Module: Cash & Expense (docs/03-sad/17-module-finance.md
// UC-FIN-003/UC-FIN-004, Epic AD task-153-161). Table names follow the
// SAD's own literal Section 5.1 dictionary (`cash_accounts`, `expenses`),
// the same implementer's-choice permission already exercised throughout
// this phase. No separate `cash_movements` table: task-154's own Backend
// Scope sources cash-account movement history directly from posted
// `JournalLine`s filtered by the account's `ledgerAccountId`, not from a
// dedicated ledger table -- a simpler design than SAD Section 3.2/5.2's
// aspirational `CashMovement` aggregate, taken per this project's task-
// spec-over-SAD priority. No `expense_categories` table either: no task
// in 156-161 builds it, and task-156's own Backend Scope models
// `category` as a plain field on Expense, not a FK.
// ---------------------------------------------------------------------------

enum CashAccountType {
  CASH
  BANK
  CLEARING
}

/// docs/03-sad/17-module-finance.md Section 5.2: "cash_accounts holds
/// branch_id, code, name, account_type, ledger_account_id, masked
/// account_number, is_active." `currentBalance` is added per task-153's
/// own Backend Scope ("CashAccount entity (branchId, name, linked
/// finance_accounts.accountId, currentBalance)") though the SAD's field
/// list doesn't list it -- a cached running balance, updated only by
/// Cash Transfer/Pay Expense, that Daily Closing (Epic AE) will use to
/// derive its "expected balance."
model CashAccount {
  id              String          @id @default(uuid()) @db.Char(36)
  branchId        String          @map("branch_id") @db.Char(36)
  code            String          @db.VarChar(30)
  name            String          @db.VarChar(150)
  accountType     CashAccountType @map("account_type")
  ledgerAccountId String          @map("ledger_account_id") @db.Char(36)
  accountNumber   String?         @map("account_number") @db.VarChar(100)
  currentBalance  Decimal         @default(0) @map("current_balance") @db.Decimal(18, 2)
  isActive        Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch        Branch         @relation(fields: [branchId], references: [id])
  ledgerAccount Account        @relation(fields: [ledgerAccountId], references: [id])
  dailyClosings DailyClosing[]

  @@unique([branchId, code])
  @@index([ledgerAccountId])
  @@map("cash_accounts")
}

enum FinanceExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

/// docs/03-sad/17-module-finance.md Section 5.2 `expenses`. `category` is
/// a plain string (see module-level note above); `expenseAccountId` is
/// the postable expense account debited on payment.
model Expense {
  id               String               @id @default(uuid()) @db.Char(36)
  expenseNo        String               @unique @map("expense_no") @db.VarChar(40)
  branchId         String               @map("branch_id") @db.Char(36)
  expenseDate      DateTime             @map("expense_date") @db.Date
  category         String               @db.VarChar(30)
  expenseAccountId String               @map("expense_account_id") @db.Char(36)
  amount           Decimal              @db.Decimal(18, 2)
  approvedAmount   Decimal?             @map("approved_amount") @db.Decimal(18, 2)
  paidAmount       Decimal?             @map("paid_amount") @db.Decimal(18, 2)
  payeeName        String?              @map("payee_name") @db.VarChar(150)
  description      String?              @db.Text
  evidenceUrl      String?              @map("evidence_url") @db.VarChar(500)
  status           FinanceExpenseStatus @default(DRAFT)

  submittedAt      DateTime? @map("submitted_at")
  approvedBy       String?   @map("approved_by") @db.Char(36)
  approvedAt       DateTime? @map("approved_at")
  rejectedBy       String?   @map("rejected_by") @db.Char(36)
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  paidBy           String?   @map("paid_by") @db.Char(36)
  paidAt           DateTime? @map("paid_at")
  paymentJournalId String?   @unique @map("payment_journal_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch         Branch   @relation(fields: [branchId], references: [id])
  expenseAccount Account  @relation(fields: [expenseAccountId], references: [id])
  paymentJournal Journal? @relation(fields: [paymentJournalId], references: [id])

  @@index([branchId, expenseDate, status])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Finance Module: Daily Closing & Doctor Fee Settlement (docs/03-sad/
// 17-module-finance.md UC-FIN-005/UC-FIN-006, Epic AE task-163-167).
// Table names follow the SAD's own literal Section 5.1 dictionary
// (`daily_closings`, `doctor_fee_settlements`), the same implementer's-
// choice permission already exercised throughout this phase.
// ---------------------------------------------------------------------------

enum DailyClosingStatus {
  SUBMITTED
  APPROVED
}

/// docs/03-sad/17-module-finance.md Section 5.2: unique closing scope
/// `(branch_id, cash_account_id, cashier_id, closing_date, shift_id)` --
/// `shift_id` is dropped since no shift concept exists anywhere in this
/// codebase (SAD's own Section 5.1 permits one consistent physical
/// design). `expectedBalance` is read from `CashAccount.currentBalance`
/// at closing time (UC-FIN-005 step 2's "approved opening balance and
/// posted cash movements" collapses to this, since no separate opening-
/// balance-approval workflow exists in any task).
model DailyClosing {
  id              String             @id @default(uuid()) @db.Char(36)
  branchId        String             @map("branch_id") @db.Char(36)
  cashAccountId   String             @map("cash_account_id") @db.Char(36)
  cashierId       String             @map("cashier_id") @db.Char(36)
  closingDate     DateTime           @map("closing_date") @db.Date
  expectedBalance Decimal            @map("expected_balance") @db.Decimal(18, 2)
  countedBalance  Decimal            @map("counted_balance") @db.Decimal(18, 2)
  variance        Decimal            @db.Decimal(18, 2)
  varianceReason  String?            @map("variance_reason") @db.Text
  denominations   Json?
  status          DailyClosingStatus @default(SUBMITTED)

  approvedBy String?   @map("approved_by") @db.Char(36)
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch      Branch      @relation(fields: [branchId], references: [id])
  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])

  @@unique([branchId, cashAccountId, cashierId, closingDate])
  @@map("daily_closings")
}

enum DoctorFeeSettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// docs/03-sad/17-module-finance.md Section 5.2/3.3: `feeAccountId` is
/// the ledger account debited at payment time -- Section 3.6's two-step
/// accrual/payment posting template is collapsed to a single payment
/// posting since no task in 166-167 builds a separate accrual step;
/// Finance explicitly picks the fee account at Generate time rather than
/// relying on an account-mapping configuration that no task specifies
/// (the same gap that blocks task-162).
model DoctorFeeSettlement {
  id           String                    @id @default(uuid()) @db.Char(36)
  settlementNo String                    @unique @map("settlement_no") @db.VarChar(40)
  branchId     String                    @map("branch_id") @db.Char(36)
  doctorId     String                    @map("doctor_id") @db.Char(36)
  periodStart  DateTime                  @map("period_start") @db.Date
  periodEnd    DateTime                  @map("period_end") @db.Date
  feeAccountId String                    @map("fee_account_id") @db.Char(36)
  grossAmount  Decimal                   @map("gross_amount") @db.Decimal(18, 2)
  deductions   Decimal                   @default(0) @db.Decimal(18, 2)
  netAmount    Decimal                   @map("net_amount") @db.Decimal(18, 2)
  status       DoctorFeeSettlementStatus @default(DRAFT)

  approvedBy       String?   @map("approved_by") @db.Char(36)
  approvedAt       DateTime? @map("approved_at")
  paidBy           String?   @map("paid_by") @db.Char(36)
  paidAt           DateTime? @map("paid_at")
  paymentJournalId String?   @unique @map("payment_journal_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Char(36)

  branch         Branch                    @relation(fields: [branchId], references: [id])
  doctor         Doctor                    @relation(fields: [doctorId], references: [id])
  feeAccount     Account                   @relation(fields: [feeAccountId], references: [id])
  paymentJournal Journal?                  @relation(fields: [paymentJournalId], references: [id])
  items          DoctorFeeSettlementItem[]

  @@index([branchId, doctorId, status])
  @@map("doctor_fee_settlements")
}

/// docs/03-sad/17-module-finance.md Section 5.2: "A child doctor_fee_
/// settlement_items projection may be added for source-level
/// traceability without modifying the authoritative source fee record."
/// `visitTreatmentId` is a plain, non-FK reference to EMR's own
/// `VisitTreatment` table (read via `IVisitTreatmentRepository`, not a
/// cross-module Prisma join) -- the `@unique` constraint is the DB-level
/// backstop for `FIN_SETTLEMENT_SOURCE_USED` (a source can appear in at
/// most one settlement, ever).
model DoctorFeeSettlementItem {
  id               String  @id @default(uuid()) @db.Char(36)
  settlementId     String  @map("settlement_id") @db.Char(36)
  visitTreatmentId String  @unique @map("visit_treatment_id") @db.Char(36)
  amount           Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  settlement DoctorFeeSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@map("doctor_fee_settlement_items")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Char(36)
  entity        String   @db.VarChar(100)
  entityId      String   @map("entity_id") @db.Char(36)
  action        String   @db.VarChar(20)
  oldValue      String?  @map("old_value") @db.LongText
  newValue      String?  @map("new_value") @db.LongText
  userId        String?  @map("user_id") @db.Char(36)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  correlationId String?  @map("correlation_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
