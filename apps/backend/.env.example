# Parakita Backend - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=Parakita
APP_PORT=4000

# --- Database (docs/04-ai-contract/06-database-contract.md DB-001: MySQL 8.x, DB-002: Prisma) ---
DATABASE_URL=mysql://parakita:password@localhost:3306/parakita
# Required by `prisma migrate dev` (Prisma Migrate's shadow database --
# https://pris.ly/d/migrate-shadow). Must be a database the DB user can
# freely create/drop tables in.
SHADOW_DATABASE_URL=mysql://parakita:password@localhost:3306/parakita_shadow

# --- JWT (docs/03-sad/02-system-architecture.md Section 16, Section 22.4) ---
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- Object Storage (docs/04-ai-contract/02-architecture-contract.md ARCH-006: S3 or MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=parakita-attachments
# docs/06-tasks/task-078.md: local-filesystem stand-in until a real S3/MinIO
# instance is provisioned (see IObjectStorageService). Optional; defaults
# to ./storage if omitted.
STORAGE_ROOT=./storage

# --- Email ---
SMTP_HOST=smtp.example.com

# --- Password Hashing (docs/04-ai-contract/05-auth-contract.md AUTH-065: bcrypt, default 12 rounds) ---
BCRYPT_SALT_ROUNDS=12

# --- CORS (docs/04-ai-contract/09-security-contract.md SEC-061/SEC-062/SEC-063: explicit whitelist, no wildcard in production) ---
FRONTEND_ORIGIN=http://localhost:3000
